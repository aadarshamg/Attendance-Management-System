# ---- API (copy to apps/api/.env) ----

# PostgreSQL with the PostGIS extension available.
#
# This app's tables all live in their own Postgres schema ("attendance", see
# prisma/schema.prisma) rather than "public" — so these can safely point at a
# Postgres instance/project another app already uses (same client, shared infra)
# without any table-name collisions. See SETUP.md "Option C".
#
# Two URLs because serverless (many short-lived connections, e.g. Vercel) and
# migrations (need prepared statements) want different Postgres connection modes:
#
# DATABASE_URL — the app's runtime connection.
#   Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify&pgbouncer=true&connect_timeout=10
#             ("Transaction pooler", port 6543 — required on Vercel/serverless)
#
# DIRECT_URL — used only by `prisma migrate`.
#   Neon:     same as DATABASE_URL with pooling turned off when you copy it
#   Supabase: same host as above but port 5432 ("Session pooler"), no pgbouncer param
#   If you're not on serverless, DIRECT_URL can just repeat DATABASE_URL.
#
# sslmode: Prisma's `require` does full certificate-chain verification (unlike
# traditional Postgres tools, where `require` just means "encrypt, don't verify").
# If you get `P1001: Can't reach database server` on a Supabase pooler despite the
# host/port/credentials all being right, switch to `sslmode=no-verify` — it still
# encrypts the connection, it just skips the chain check Prisma's TLS stack does
# by default. Confirmed needed for Supabase poolers; try it for any provider if
# `require` gives you an unexplained P1001.
DATABASE_URL="postgresql://user:pass@host:6543/db?sslmode=no-verify&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://user:pass@host:5432/db?sslmode=no-verify&connect_timeout=10"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_TTL="12h"

# ---- S3-compatible object storage (photos) ----
# Works with Cloudflare R2, Supabase Storage, AWS S3, or MinIO.
# R2_* names are still accepted; S3_* take precedence if both are set.
#
# Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#
# Supabase Storage (Project Settings -> Storage -> S3 access keys):
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<your project region, e.g. ap-south-1>
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="ams-attendance-images"
S3_FORCE_PATH_STYLE="true"

# OpenStreetMap Nominatim reverse geocoding (server-side only).
# Public instance requires a descriptive User-Agent and <= 1 req/s.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="AttendanceMgmtSystem/1.0 (contact: you@example.com)"

# Policy knobs
GEOFENCE_ACCURACY_THRESHOLD_M=100
TIME_DRIFT_THRESHOLD_SECONDS=300
IMAGE_RETENTION_DAYS=90
MAX_UPLOAD_BYTES=614400
SIGNED_URL_TTL_SECONDS=300

# Server
PORT=3000
CORS_ORIGIN="https://localhost:5173"

# Only needed when deploying to Vercel: guards GET /internal/retention/purge, which
# Vercel Cron calls on a schedule (see apps/api/vercel.json). Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` to that path once this is set as a project env var.
# Unused on a persistent host (Docker/local `npm run dev`), where the daily @Cron job in
# retention.service.ts already covers this — leave it unset there.
CRON_SECRET=""

# ---- Web (copy to apps/web/.env) ----
# VITE_API_BASE_URL="https://localhost:3000"
