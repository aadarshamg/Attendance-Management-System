{
  "name": "attendance-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Geo-tagged photo attendance for construction sites (walking-skeleton MVP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace @ams/shared",
    "dev": "npm run build --workspace @ams/shared && npm-run-all --parallel dev:shared dev:api dev:web",
    "dev:shared": "npm run dev --workspace @ams/shared",
    "dev:api": "npm run start:dev --workspace @ams/api",
    "dev:web": "npm run dev --workspace @ams/web",
    "build": "npm run build --workspace @ams/shared && npm run build --workspace @ams/api && npm run build --workspace @ams/web",
    "db:migrate": "npm run db:migrate --workspace @ams/api",
    "db:seed": "npm run db:seed --workspace @ams/api",
    "purge:images": "npm run purge:images --workspace @ams/api",
    "setup:r2-lifecycle": "npm run setup:r2-lifecycle --workspace @ams/api",
    "test": "npm run test --workspace @ams/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
