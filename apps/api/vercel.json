{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:generate && npm run db:migrate",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/internal/retention/purge", "schedule": "0 2 * * *" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
